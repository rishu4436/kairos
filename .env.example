# paper (default) or live.
# live calls Binance Web3 and never substitutes synthetic data when a request fails.
# mock is accepted as an alias of paper.
# KAIROS_DATA_MODE=

# Server only. Sent as X-OC-APIKEY. Do not prefix these with NEXT_PUBLIC.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=

# Optional. Defaults are the official base URL, a 5s receive window, a 10s timeout,
# a 15s dashboard poll, and freshness thresholds of 30s / 120s.
# BINANCE_WEB3_BASE_URL=
# BINANCE_WEB3_RECV_WINDOW_MS=
# KAIROS_REQUEST_TIMEOUT_MS=
# KAIROS_REFRESH_INTERVAL_MS=
# KAIROS_FRESH_MAX_MS=
# KAIROS_AGING_MAX_MS=

# --- Research model: qwen, xai, gemini, or explicit test-only mock ---
# Selection is explicit; there is no automatic fallback.
# Reuse the one server credential for the selected provider only.
# Default models: qwen3.8-max, grok-4.7, gemini-3.8-flash.
# Server only. Do not prefix the key with NEXT_PUBLIC.
# KAIROS_LLM_PROVIDER=
# KAIROS_LLM_API_KEY=
# KAIROS_LLM_MODEL=
# KAIROS_LLM_TIMEOUT_MS=
# KAIROS_QWEN_BASE_URL=
# KAIROS_LLM_LIVE_TEST=
# For Gemini, use these SAME settings privately in .env.local:
# KAIROS_LLM_PROVIDER=
# KAIROS_LLM_MODEL=
# KAIROS_LLM_API_KEY=
# GEMINI_LIVE_TEST=

# --- Financial Modeling Prep (underlying equity events) ---
# Server only. Do not prefix with NEXT_PUBLIC. Query parameter name is apikey.
# FMP_API_KEY=

# --- Autonomous runtime state ---
# memory is the local default and is ephemeral.
# redis is the durable deployment. It is required only when selected.
# A missing REDIS_URL with redis selected fails closed: STATE_BACKEND_NOT_CONFIGURED.
# KAIROS_STATE_BACKEND=
REDIS_URL=
# Select redis privately in .env.local with a redis:// or rediss:// connection URL.
# Never put real credentials in this example file.
# KAIROS_CYCLE_INTERVAL_MS=
# Local persistent runner: npm run kairos:runner
# That process invokes runKairosAutonomousCycle. Importing the app does not start it.
# KAIROS_RESEARCH_INTERVAL_MS=
# FMP_LIVE_TEST=
# FMP_NEWS_TTL_MS=
# FMP_EARNINGS_TTL_MS=
# FMP_TIMEOUT_MS=
# EVENT_PRE_DAYS=
# EVENT_POST_DAYS=
# EVENT_REDUCTION_ENABLED=

# --- Agentic Wallet (user trading capital) ---
# This is not the Agent Studio operating wallet.
# KAIROS_WALLET_ADDRESS=
# Operator-attested Agentic Wallet token scope. Not a CLI proof of the Binance allow list.
# Comma-separated chain:contract only. Never tickers.
# KAIROS_AGENTIC_ALLOWED_TOKENS=
# KAIROS_AGENTIC_WALLET_EXECUTE=
# LIVE_AGENTIC_WALLET_TEST=
# KAIROS_LIVE_TEST_CEILING_USD=
# KAIROS_AGENTIC_WALLET_LIVE=
# KAIROS_EXECUTION_LIVE_TEST=

# --- Agent Studio (agent operating capital) ---
# Plain `bag` may be a different program. Set this to the npm binary when needed.
# Do not commit a machine-specific path.
# KAIROS_BAG_BIN=
# WALLET_PASSWORD unlocks .studio/wallets/ and must not be committed.
# Studio deliverable pinning is separate from KAIROS Redis state.
# STORAGE_API_KEY=
# STORAGE_API_URL=
# PIEVERSE_LLM_API_KEY, OPENROUTER_API_KEY, OPENAI_API_KEY, and ANTHROPIC_API_KEY
# are Studio LLM keys, not KAIROS_LLM_API_KEY.
